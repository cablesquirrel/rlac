---
import { Image } from 'astro:assets';
import type { ImageQuality, ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  quality?: ImageQuality;
  originalSrc?: string;
  openInNewTab?: boolean;
}

const { 
  src, 
  alt, 
  width, 
  quality = "high", 
  openInNewTab = false, 
  ...rest 
} = Astro.props;

---

<a
  href={src.src}
  class="image-link"
  data-lightbox={openInNewTab ? undefined : "true"}
  target={openInNewTab ? '_blank' : '_self'}
  rel={openInNewTab ? 'noopener noreferrer' : undefined}
>
  <Image
    src={src}
    alt={alt}
    width={width}
    quality={quality}
    class="image-link__preview"
    {...rest}
  />
</a>

<style>
  .image-link {
    display: inline-block;
    cursor: zoom-in;
    transition: transform 0.2s ease;
    text-decoration: none;
    width: 100%;
    padding: 1.0rem;
  }
  
  .image-link:hover {
    transform: scale(1.02);
  }
  
  .image-link__preview {
    display: block;
    margin: auto;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  @media screen and (max-width: 640px) {
    .image-link {
      padding: 0.5rem;
    }
  }

  :global(.image-lightbox-overlay) {
    display: none;
    position: fixed;
    inset: 0;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
    cursor: zoom-out;
  }

  :global(.image-lightbox-overlay.is-open) {
    display: flex;
  }

  :global(.image-lightbox-overlay__img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    margin: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    cursor: default;
  }

  :global(.image-lightbox-overlay__close) {
    position: fixed;
    top: 0.75rem;
    right: 1rem;
    background: transparent;
    border: none;
    color: white;
    font-size: 2.5rem;
    line-height: 1;
    padding: 0.25rem 0.75rem;
    cursor: pointer;
  }

  :global(body.image-lightbox-open) {
    overflow: hidden;
  }
</style>

<script>
  const win = window as unknown as Window & { __imageLightboxInit?: boolean };

  if (!win.__imageLightboxInit) {
    win.__imageLightboxInit = true;

    let overlay: HTMLDivElement | null = null;
    let overlayImg: HTMLImageElement | null = null;
    let lastTrigger: HTMLElement | null = null;

    function buildOverlay() {
      overlay = document.createElement('div');
      overlay.className = 'image-lightbox-overlay';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', 'Image preview');

      overlayImg = document.createElement('img');
      overlayImg.className = 'image-lightbox-overlay__img';
      overlay.appendChild(overlayImg);

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'image-lightbox-overlay__close';
      closeBtn.setAttribute('aria-label', 'Close image preview');
      closeBtn.innerHTML = '&times;';
      closeBtn.addEventListener('click', closeLightbox);
      overlay.appendChild(closeBtn);

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeLightbox();
      });

      document.body.appendChild(overlay);
    }

    function openLightbox(href: string, alt: string | undefined, trigger: HTMLElement) {
      if (!overlay || !overlayImg) buildOverlay();

      lastTrigger = trigger;
      overlayImg!.src = href;
      overlayImg!.alt = alt || '';
      overlay!.classList.add('is-open');
      document.body.classList.add('image-lightbox-open');
    }

    function closeLightbox() {
      if (!overlay || !overlay.classList.contains('is-open')) return;

      overlay.classList.remove('is-open');
      document.body.classList.remove('image-lightbox-open');
      lastTrigger?.focus();
      lastTrigger = null;
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const trigger = target?.closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!trigger) return;

      e.preventDefault();
      openLightbox(trigger.href, trigger.querySelector('img')?.alt, trigger);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  }
</script>